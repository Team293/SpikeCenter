{
  "name": "@spike/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "format": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@spike/prettier-config",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./schemas/project": "./src/routers/project/project.schema.ts"
  },
  "devDependencies": {
    "@spike/eslint-config": "workspace:*",
    "@spike/prettier-config": "workspace:*",
    "@spike/tailwind-config": "workspace:*",
    "@spike/typescript-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@spike/lms-platform": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "eslint": "^9.31.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@spike/eslint-config/base",
      "@spike/eslint-config/react"
    ]
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "dependencies": {
    "@spike/db": "workspace:*",
    "@spike/auth": "workspace:*",
    "@trpc/server": "catalog:",
    "zod": "catalog:"
  }
}
