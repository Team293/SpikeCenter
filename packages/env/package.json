{
  "name": "@spike/env",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "format": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@spike/prettier-config",
  "exports": {
    "./env.server": "./src/env.server.ts",
    "./env.shared": "./src/env.shared.ts"
  },
  "devDependencies": {
    "@spike/eslint-config": "workspace:*",
    "@spike/prettier-config": "workspace:*",
    "@spike/tailwind-config": "workspace:*",
    "@spike/typescript-config": "workspace:*",
    "eslint": "^9.31.0"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.48.0",
    "@types/node": "^24.2.1",
    "dotenv": "^17.2.0",
    "dotenv-flow": "^4.1.0",
    "find-up": "^7.0.0",
    "zod": "catalog:"
  }
