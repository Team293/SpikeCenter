{
  "name": "turbo-scaffold",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production dotenvx run --convention=nextjs -- turbo run build",
    "dev": "NODE_ENV=development dotenvx run --convention=nextjs -- turbo run dev",
    "dev:setup": "docker start spike-center-dev || docker run --name spike-center-dev -e POSTGRES_PASSWORD=123456789 -p 7501:5432 -d postgres",
    "lint": "dotenvx run --convention=nextjs -- turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "dotenvx run --convention=nextjs -- turbo run check-types"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.48.0",
    "pg": "catalog:",
    "validator": "13.7.0"
  },
  "catalogs": {
    "default": {
      "react": "19.1.1",
      "react-dom": "19.1.1"
    }
  }
}
